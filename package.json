{
  "name": "robattle-arena",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "check": "tsc --noEmit",
    "sim": "bun tools/sim-test.ts",
    "preview-art": "bun tools/preview-art.ts",
    "build": "bun build --compile --minify server.ts --outfile dist/robattle-arena",
    "build:win": "bun build --compile --minify --target=bun-windows-x64 server.ts --outfile dist/robattle-arena.exe"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
